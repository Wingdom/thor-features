<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Thor OLED Wash</string>

    <!-- Deliberately says nothing about WHEN a wash happens. That depends on
         whether the module is installed and on the Automatic setting, and the
         line under "Run by itself" below says so from the live state. The
         previous version of this string asserted "there is no idle trigger
         yet", which was true when it was written and contradicted the line
         right beneath it once the module existed. Static text should not
         describe something that varies. -->
    <string name="intro">Sweeps a band of bright noise down each OLED panel, so
        static content does not sit on the same pixels for hours.\n\nA wash
        stops on any touch, button, stick or trigger. It never changes
        brightness and never keeps the screen awake.</string>

    <string name="label_speed">Sweep time</string>
    <string name="label_band">Band height</string>
    <string name="label_cycles">Sweeps</string>
    <string name="label_grain">Noise grain</string>
    <string name="label_screens">Screens</string>

    <string name="screens_all">Both</string>
    <string name="screens_primary">Top only</string>
    <string name="screens_secondary">Bottom only</string>

    <string name="run_now">Run now</string>

    <string name="status_panels">Will wash %1$d of %2$d panels:</string>
    <string name="status_none">No panel available to wash.</string>

    <string name="wash_hint">Tap, or press anything, to stop</string>

    <string name="section_auto">Run by itself</string>
    <string name="label_auto">Automatic</string>
    <string name="label_idle">After</string>
    <string name="auto_off">Off</string>
    <string name="auto_on">On</string>
    <string name="idle_suffix">%1$d min</string>
    <string name="auto_ready">The thor-oledwatch module is installed, so these
        settings take effect. It washes when the screen is on, unlocked, and you
        have not touched anything for the chosen time.</string>
    <string name="auto_no_module">Install the <b>thor-oledwatch</b> Magisk module
        to use this. Without it these settings are saved but nothing reads them,
        and Run now is the only way to wash.</string>
</resources>
