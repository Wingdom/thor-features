<?xml version="1.0" encoding="utf-8"?>
<!-- Every pair here was measured, not eyeballed. The worst contrast ratio in
     this scheme is 6.61:1, against a WCAG floor of 4.5 for normal text and 3.0
     for large. What it replaces had the unselected buttons at 2.99:1, which is
     a straightforward fail, and the selected ones at a marginal 4.74:1. -->
<resources>
    <color name="background">#FFFAFAFA</color>
    <color name="heading">#FF101010</color>
    <color name="body">#FF333333</color>
    <color name="label">#FF5A5A5A</color>

    <!-- Selected is a filled container with text on top of it, rather than
         coloured text on the stock grey button. Material's filled-versus-
         outlined distinction: the chosen option should read as chosen from
         across the room, not be told apart by hue alone. -->
    <color name="selected_fill">#FF1F5A48</color>
    <color name="selected_text">#FFFFFFFF</color>
    <color name="unselected_text">#FF1F1F1F</color>
    <color name="outline">#FFC8C8C8</color>
</resources>
