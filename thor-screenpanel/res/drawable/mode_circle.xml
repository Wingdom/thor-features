<?xml version="1.0" encoding="utf-8"?>
<!-- The filled accent circle marking the active mode, as in the stock panel. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/panel_selected" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/panel_unselected" />
        </shape>
    </item>
</selector>
