<?xml version="1.0" encoding="utf-8"?>
<!-- One half of the 60/120 switch. Selected reads as the filled part of a
     slider track, so the control matches the brightness row beside it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bright_track_fill" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape></item>
</selector>
