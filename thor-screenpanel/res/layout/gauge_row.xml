<?xml version="1.0" encoding="utf-8"?>
<!-- One telemetry reading: name, bar, number.

     Inflated at runtime rather than included statically, because how many of
     these there are is not known until the device has been read - the
     temperature gauges depend on which thermal zone types exist, and the GPU
     row depends on whether its node is readable at all on this build.

     The number sits at the trailing edge with a fixed minimum width so the
     column of values lines up regardless of how wide each bar ends up. It is
     monospaced: these figures change every second, and a proportional font
     makes the whole row twitch sideways as the digits change width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <TextView
        android:id="@+id/gauge_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="62dp"
        android:maxLines="1"
        android:textColor="@color/panel_on_surface_dim"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/gauge_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:progressDrawable="@drawable/gauge_track"
        android:max="100"
        android:progress="0" />

    <TextView
        android:id="@+id/gauge_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="76dp"
        android:maxLines="1"
        android:gravity="end"
        android:fontFamily="monospace"
        android:textColor="@color/panel_on_surface"
        android:textSize="12sp" />
</LinearLayout>
