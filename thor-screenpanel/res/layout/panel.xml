<?xml version="1.0" encoding="utf-8"?>
<!-- A tab strip, the selected tab's cards, and stock's "Mode" row.

     Mode sits at the BOTTOM, nearest the AYN button, at the user's request
     (2026-10-27) - it is the row reached most often and the one the button
     exists for. Do not reorder these again.

     The paddings throughout are tighter than they look like they want to be,
     and that is load-bearing rather than taste. Measured on the device
     2026-11-04: the usable band between the status bar (56px) and the
     navigation bar (96px) is 928px, of which this column gets 816 after its
     own margins. Adding the tab strip pushed the Controls tab to 928px of
     content, and the Mode card - the last child - was silently clipped to
     101px of its 221, losing all three of its labels. Do not restore these
     paddings without re-measuring; the column has about 38px of headroom.

     Mode is deliberately NOT one of the tabs. Stock put its mode options and
     its quick-settings tiles on separate tabs, and the earlier version of
     this file was one scrolling column on the grounds that "a tap to reach
     the fan is a tap the physical button was supposed to save". Telemetry
     forced the question, because a gauge card is too tall to stack: there is
     no longer room for everything at once.

     The resolution is that the tabs switch only the upper content. Controls
     and Telemetry take turns; Mode is always on screen, still at the bottom,
     still one tap from the button. So the tab costs a tap to reach the
     gauges - which nobody taps a button to see - and costs nothing to reach
     Mode or the fan, which is what the 2026-10-27 request was about. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/panel_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <!-- The tab strip reuses the 60/120 switch's shapes rather than
             introducing a third kind of selector. It is the same gesture -
             pick one of two - so it should look the same. -->
        <LinearLayout
            android:id="@+id/tab_strip"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            android:background="@drawable/hz_group">

            <TextView
                android:id="@+id/tab_controls"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/hz_seg"
                android:textColor="@color/hz_text"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/tab_controls" />

            <TextView
                android:id="@+id/tab_telemetry"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:minWidth="104dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:background="@drawable/hz_seg"
                android:textColor="@color/hz_text"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/tab_telemetry" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_bright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_card"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">


            <include layout="@layout/brightness_row" android:id="@+id/bright_top" />
            <include layout="@layout/brightness_row" android:id="@+id/bright_bottom" />
            <include layout="@layout/brightness_row" android:id="@+id/row_volume" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/panel_card"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <include layout="@layout/quick_item" android:id="@+id/quick_fan" />
                <include layout="@layout/quick_item" android:id="@+id/quick_stick" />
                <include layout="@layout/quick_item" android:id="@+id/quick_move" />
                <include layout="@layout/quick_item" android:id="@+id/quick_clean" />
                <include layout="@layout/quick_item" android:id="@+id/quick_haptics" />
            </LinearLayout>
        </LinearLayout>

        <!-- The telemetry tab. Starts hidden: Controls is the tab the button
             opens onto, because the button exists to change something.

             No background on this one, unlike the cards above it: it is a
             container, and the cards are inside it. The tab is several cards
             with gaps between them rather than one, so that the gaps can do
             the grouping. -->
        <LinearLayout
            android:id="@+id/card_telemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/telemetry_card" android:id="@+id/telemetry_body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/panel_card"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <include layout="@layout/mode_item" android:id="@+id/mode_dual" />
                <include layout="@layout/mode_item" android:id="@+id/mode_top" />
                <include layout="@layout/mode_item" android:id="@+id/mode_bottom" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
