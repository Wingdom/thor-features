<?xml version="1.0" encoding="utf-8"?>
<!-- The telemetry tab: a row of ring cards over a card of bars.

     Three ring cards rather than one, because a gap between cards reads as a
     change of subject and there are three subjects here - what the game is
     doing, what the chip is doing, and what the device is spending. The gaps
     are the same 6dp the cards elsewhere in this panel use, so the tab is
     built out of the same units as the Controls tab beside it.

     The temperatures and fan get a section of their own beneath, which is
     what separates "readings you watch" from "readings you check".

     minHeight is not cosmetic. The panel is bottom-anchored and WRAP_CONTENT,
     so a short tab makes the whole window shorter and the tab strip jumps -
     measured at 271px between tabs before this was added. Sizing the tab to
     the Controls tab holds the strip still; the cards centre in whatever
     slack is left. Mode never moved either way, being anchored to the bottom.

     Both sections are filled at runtime from what discovery actually found,
     so a missing node costs a gauge rather than drawing a zero. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="250dp"
    android:orientation="vertical"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/ring_cards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false" />

    <LinearLayout
        android:id="@+id/bar_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/panel_card"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <TextView
        android:id="@+id/gauge_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/panel_on_surface_dim"
        android:textSize="12sp"
        android:visibility="gone"
        android:text="@string/telemetry_none" />
</LinearLayout>
