<?xml version="1.0" encoding="utf-8"?>
<!-- The telemetry tab: a row of ring gauges over a row of bars.

     Shaped after stock's own overlay, which put its headline metrics in
     coloured rings. The four rings are the readings that move while a game is
     running; the four bars beneath are the ones you check rather than watch.

     minHeight is not cosmetic. The panel is bottom-anchored and WRAP_CONTENT,
     so a short tab makes the whole window shorter and the tab strip jumps -
     measured at 271px between tabs before this, which put "Controls" nowhere
     near where the finger had just tapped "Telemetry". Sizing this tab to
     match the Controls tab's height holds the strip still. Mode never moved
     either way; it is anchored to the bottom.

     Both rows are filled at runtime from whatever discovery actually found,
     so a missing node costs a cell rather than drawing a zero. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="250dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/ring_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false" />

    <LinearLayout
        android:id="@+id/bar_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false" />

    <TextView
        android:id="@+id/gauge_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/panel_on_surface_dim"
        android:textSize="12sp"
        android:visibility="gone"
        android:text="@string/telemetry_none" />
</LinearLayout>
